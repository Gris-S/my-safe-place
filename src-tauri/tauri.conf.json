{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MY SAFE PLACE",
  "version": "0.1.1",
  "identifier": "fr.gris.mysafeplace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5290",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "MY SAFE PLACE", "width": 760, "height": 680, "minWidth": 480, "minHeight": 420, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Range tes fichiers sur un autre disque, en laissant un lien à leur place"
  }
}
